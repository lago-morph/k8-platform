# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars.
# In CI these values are injected via TF_VAR_* environment variables; this
# file is only needed for local runs.

aws_region      = "us-east-1"
environment     = "dev"
domain          = "example.com"      # must match terraform/base; auto-discovered in CI
tf_state_bucket = "my-tfstate-bucket" # auto-derived in CI from account ID

cluster_name    = "k8-platform-mgmt"
cluster_version = "1.29"

# Pluralsight sandbox: t3.medium is the recommended type (see ai/testing-guidelines.md).
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3

availability_zones = ["us-east-1a", "us-east-1b"]

# Helm chart versions — pin deliberately; bump with a commit explaining why.
argocd_version        = "6.7.3"
crossplane_version    = "1.15.1"
eso_version           = "0.9.13"
ingress_nginx_version = "4.10.0"
