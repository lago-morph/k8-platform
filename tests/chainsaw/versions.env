# Pinned tool versions for the Chainsaw harness. Sourced by run.sh and
# checked by tests/unit/test_chainsaw_kind_config.sh.
#
# Bump deliberately; out-of-band drift between sandbox and CI is the
# single largest source of false negatives in a kind+chainsaw setup.

# Crossplane Helm chart — must match terraform/management/variables.tf:75
# (crossplane_version). Drift between the management cluster and the
# chainsaw kind cluster means Composition behaviour can be tested green
# locally and break in management.
CROSSPLANE_CHART_VERSION="2.3.0"

# Upbound provider-family-aws package — must match
# terraform/management/variables.tf:81 (crossplane_provider_family_aws_version).
# v2.x is the line designed for Crossplane v2.
PROVIDER_FAMILY_AWS_VERSION="v2.5.0"

# Upbound provider-aws-secretsmanager — the SPECIFIC child provider that
# implements the secretsmanager.aws.upbound.io API group. The family
# package above doesn't bundle child providers; without this the
# PlatformSecret Composition's ASM Secret resource never reconciles and
# the XR stays Synced=False forever. Pinned same version as the family.
PROVIDER_AWS_SECRETSMANAGER_VERSION="v2.5.0"

# Upbound provider-aws-rds — the SPECIFIC child provider that implements
# the rds.aws.m.upbound.io API group. The family package above doesn't
# bundle child providers; without this the XDatabase RDS Composition's
# Instance resource never reconciles and the XR stays Synced=False forever.
# Pinned same version as the family. Must match
# terraform/management/variables.tf (crossplane_provider_aws_rds_version).
PROVIDER_AWS_RDS_VERSION="v2.5.0"

# crossplane-contrib function-patch-and-transform package — implements
# the legacy `resources/patches` syntax inside a v2 Pipeline composition.
# Crossplane v2 removed `spec.resources` from the Composition v1 schema;
# the function is the supported migration path.
FUNCTION_PATCH_AND_TRANSFORM_VERSION="v0.10.6"

# crossplane-contrib function-environment-configs — merges named
# EnvironmentConfig data into the pipeline environment so a Composition
# can read account-ephemeral infra values (private subnet IDs, route53
# zone id, root domain) that terraform/management materializes from the
# base Terraform output. Used by the platform-cluster Composition; must
# match terraform/management/variables.tf
# (crossplane_function_environment_configs_version).
FUNCTION_ENVIRONMENT_CONFIGS_VERSION="v0.3.0"

# kind CLI version — pinned. New kind releases occasionally change CLI
# flags (e.g. --image, --wait).
KIND_VERSION="v0.27.0"

# kindest/node image — pinned by tag AND digest. The digest is the
# load-bearing pin; the tag is for readability. Bump the pair together.
# Find current digest at https://hub.docker.com/r/kindest/node/tags
KINDEST_NODE_IMAGE="kindest/node:v1.32.0@sha256:c48c62eac5da28cdadcf560d1d8616cfa6783b58f0d94cf63ad1bf49600cb027"

# Chainsaw CLI — k8s e2e test runner. Pinned tag.
CHAINSAW_VERSION="v0.2.12"

# mikefarah/yq (Go) — the ONLY supported yq. THE SAME VERSION MUST BE
# INSTALLED IN THE SANDBOX AND IN CI. scripts/composition-render.sh's
# normalize_stream uses mikefarah `yq ea` syntax; the Python `yq`
# (kislyuk) that ships by default in many sandboxes silently mis-parses
# it and produces spurious golden mismatches (see OI-2026-06-06-1).
# CI (.github/workflows/unit-tests.yml) installs this exact version;
# `scripts/sandbox-setup.sh` installs it locally — run that first.
YQ_VERSION="v4.44.3"

# Helm CLI — MUST match azure/setup-helm in .github/workflows/unit-tests.yml
# and chainsaw.yml (version: v3.16.4). The spoke add-ons + chainsaw renders
# use helm; sandbox/CI drift produces spurious template diffs.
HELM_VERSION="v3.16.4"

# ArgoCD CLI — used for live hub/spoke cluster ops from the sandbox. The EKS
# kube-API is private-CA-blocked from the sandbox, so the argocd CLI (against
# the public ingress NLB) + the ArgoCD REST API are the supported live
# read/sync path. Pinned to the deployed argocd-server version for parity.
ARGOCD_VERSION="v3.4.3"

# ASM secret name prefix for chainsaw scenarios. Two separate facts:
#   1. The IRSA policy attached to the CI runner role MUST grant
#      secretsmanager:* on arn:aws:secretsmanager:*:*:secret:${ASM_PREFIX}*
#   2. Every claim created by a chainsaw scenario MUST use this prefix
#      so the cleanup trap can wildcard-delete without nuking real data.
ASM_PREFIX="k8-platform-chainsaw"
