# ════════════════════════════════════════════════════════════════════════════
# OPEN QUESTION — Grafana Alloy agent on the MANAGEMENT (hub) cluster.
# This file is intentionally `.yaml.todo`, NOT `.yaml`: it is NOT yet synced.
# ════════════════════════════════════════════════════════════════════════════
#
# Why it is parked as a TODO (the AppProject conflict, REQ-OBS-02):
#
#   Alloy on the hub is a THIRD-PARTY Helm chart whose DESTINATION is the hub
#   in-cluster server (https://kubernetes.default.svc). Neither existing
#   AppProject can host it cleanly:
#
#     - k8-platform  — owns the hub destination, BUT its sourceRepos are locked
#       to THIS repo only ("no third-party charts via Argo" — auto-008). Adding
#       grafana.github.io/helm-charts to k8-platform.sourceRepos would silently
#       re-open the hub to arbitrary upstream charts — the exact lockdown
#       auto-008 S1 defends. NOT done.
#
#     - platform-spoke — already allows the grafana chart repo, BUT its
#       destinations deliberately EXCLUDE https://kubernetes.default.svc (the
#       hub). auto-008 / test_platform_spoke_appproject.sh gate that exclusion.
#       Pointing a platform-spoke Application at the hub would be REJECTED by
#       ArgoCD at sync (destination not permitted by project) — and putting it in
#       argocd/apps/spoke/ as a live `.yaml` would also FAIL
#       tests/unit/test_spoke_apps.sh (which requires destination.name, not
#       destination.server). So it CANNOT live in this dir as a synced manifest
#       without breaking the spoke contract.
#
# Per the phase-4 brief: the central stack (Prometheus/Grafana/Loki) is targeted
# at the SPOKE and shipped now (observability-kube-prometheus-stack.yaml +
# observability-loki.yaml). The hub Alloy AGENT is parked here as a documented
# TODO because the project model does not cleanly allow it yet.
#
# RESOLUTION OPTIONS (pick one when phase-4 lands the hub agent live — needs a
# human decision; flagged in the run summary):
#
#   (A) New dedicated `hub-addons` AppProject: destination =
#       https://kubernetes.default.svc, sourceRepos = this repo +
#       grafana.github.io/helm-charts ONLY, kind whitelist scoped to Alloy's
#       DaemonSet/RBAC/ConfigMap. Mirrors the platform-spoke pattern for the hub,
#       keeps k8-platform's "no third-party charts" intent intact. PREFERRED —
#       smallest, most auditable blast radius.
#
#   (B) Vendor Alloy's rendered manifests into this repo (helm template at author
#       time → plain YAML under platform-services/observability/alloy/manifests/)
#       and sync them from THIS repo under the EXISTING k8-platform project — no
#       sourceRepos change. Matches the Crossplane-chart vendoring precedent
#       (auto-008 OI-2026-06-05-2). Heavier to maintain on chart bumps.
#
#   (C) Run Alloy on the hub via a Crossplane provider-helm Release (rejected as
#       the spoke mechanism in auto-008 §8 for collapsing the ArgoCD/Crossplane
#       split — same objection applies here). NOT preferred.
#
# When a resolution is chosen: rename this file to .yaml, set spec.project to the
# new project (option A) or k8-platform (option B), and wire it into the obs
# tests. The body below is the option-(A) draft, kept for reference.
# ────────────────────────────────────────────────────────────────────────────
#
# apiVersion: argoproj.io/v1alpha1
# kind: Application
# metadata:
#   name: hub-observability-alloy
#   namespace: argocd
#   annotations:
#     # Wave 40 (phase-4 observability band) — after the spoke central stack so
#     # the remote_write / Loki-push endpoints exist before the agent starts.
#     argocd.argoproj.io/sync-wave: "40"
# spec:
#   # OPEN QUESTION: requires the new `hub-addons` project (option A) — this is
#   # the HUB destination, which platform-spoke forbids and k8-platform won't
#   # carry third-party charts for. Do NOT set this to platform-spoke (sync would
#   # be rejected) or k8-platform (lockdown) without the corresponding project
#   # change above.
#   project: hub-addons
#   sources:
#     - repoURL: https://grafana.github.io/helm-charts
#       chart: alloy
#       targetRevision: 0.12.6
#       helm:
#         valueFiles:
#           - $values/platform-services/observability/alloy/values.yaml
#         # OVERLAID-AT-REGISTRATION: valuesObject patches the spoke
#         # Prometheus remote_write URL + Loki push URL (account-ephemeral,
#         # depend on <domain>). Kept absent in git.
#     - repoURL: https://github.com/lago-morph/k8-platform.git
#       targetRevision: main
#       ref: values
#   destination:
#     # The HUB, in-cluster. This is why platform-spoke cannot host it.
#     server: https://kubernetes.default.svc
#     namespace: monitoring-agent
#   syncPolicy:
#     automated:
#       prune: true
#       selfHeal: true
#     syncOptions:
#       - CreateNamespace=true
#       - ServerSideApply=true
#     retry:
#       limit: 5
#       backoff:
#         duration: 10s
#         factor: 2
#         maxDuration: 5m
