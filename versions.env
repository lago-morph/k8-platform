# Pinned tool versions for top-level CI workflows. Each pin is
# referenced both from `.github/workflows/*.yml` (CI install steps)
# and from local-developer install scripts. Bump deliberately; a single
# source of truth keeps CI and local environments in sync.
#
# Separate from `tests/chainsaw/versions.env`, which pins
# cluster-runtime versions (Crossplane chart, provider packages, kind,
# chainsaw) for the chainsaw harness.

# kubeconform — static YAML lint against CRD JSON schemas. Pinned in
# .github/workflows/unit-tests.yml and consumed by
# tests/unit/test_kubeconform_manifests.sh. SPEC-S6.
KUBECONFORM_VERSION="v0.6.7"

# ArgoCD — a PAIRED pin (L31): the helm CHART version deployed by
# terraform/management (variables.tf `argocd_version` — terraform cannot
# source this file, so that default is a deliberate duplicate held equal
# by tests/unit/test_version_pin_consistency.sh) and the ArgoCD APP
# version that chart ships (argo-helm Chart.yaml appVersion; chart 6.7.3
# → v2.10.4). scripts/fetch-crds-for-kubeconform.sh sources this file and
# fetches the argoproj CRD schemas at ARGOCD_APP_VERSION, so the
# kubeconform store always validates against the DEPLOYED ArgoCD — bump
# the pair together (retro 2026-06-10-218: the store sat at v2.13.1
# against a deployed v2.10.4 for its entire life before this pin).
ARGOCD_CHART_VERSION="6.7.3"
ARGOCD_APP_VERSION="v2.10.4"
